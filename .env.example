NODE_ENV=production
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
PREFIX=^

# Billing Owners
OWNERS=
PAYPAL_OWNER_ID=
VODAFONE_OWNER_ID=

# Database - MySQL
DATABASE_URL="mysql://<USERNAME>:<PASSWORD>@127.0.0.1:3306/<DATABASE_NAME>"
TEST_DATABASE_URL="mysql://pixy:pixy_test_password@127.0.0.1:3307/pixy_test"

# Credential Encryption
PIXY_CREDENTIAL_ENCRYPTION_KEY=

# RAG - local Node -> Qdrant/Python services
RAG_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=pixy_knowledge
RAG_SERVICE_URL=http://127.0.0.1:8008
RAG_INFERENCE_URL=http://127.0.0.1:8008
RAG_CANDIDATE_K=20
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
RAG_REQUEST_TIMEOUT_MS=10000
RAG_MAX_CONTEXT_CHARS=10000

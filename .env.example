NODE_ENV=production
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
PREFIX=^

# Billing Owners

OWNERS=
PAYPAL_OWNER_ID=
VODAFONE_OWNER_ID=

# Database - MySQL

DATABASE_URL="mysql://<USERNAME>:<PASSWORD>@127.0.0.1:3306/<DATABASE_NAME>"

# Credential Encryption

PIXY_CREDENTIAL_ENCRYPTION_KEY=

# ChatGPT Workspace Agent Bridge (optional)
# Set the public HTTPS origin that reverse-proxies /mcp to PIXY_MCP_PORT.

PIXY_PUBLIC_BASE_URL=
PIXY_MCP_PORT=3100

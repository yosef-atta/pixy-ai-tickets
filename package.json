{
  "name": "pixy",
  "version": "0.5.0",
  "private": true,
  "description": "AI-powered Discord ticket assistant with guild-scoped knowledge and escalation routing.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check": "node scripts/release-preflight.js",
    "db:up": "docker compose --env-file .env.docker up -d mysql",
    "db:down": "docker compose --env-file .env.docker down",
    "db:clear": "node scripts/clear-database.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node prisma/seed-mysql.js",
    "pretest": "prisma generate",
    "test": "node test/run-tests.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.3.0",
    "mariadb": "^3.4.5"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "overrides": {
    "undici": "6.27.0",
    "@hono/node-server": "1.19.13"
  }
}
